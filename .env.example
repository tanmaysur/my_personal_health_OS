# VITAL — environment variables (Milestone 1+)
# Copy to `.env.local` for local development. Never commit real secrets.

# --- Future: Supabase (not used in Milestone 1) ---
# Project URL from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Anon / public key (safe for the browser when RLS is enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server only. Do NOT prefix with NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=
