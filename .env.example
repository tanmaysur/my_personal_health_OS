# VITAL — environment variables
# Copy to `.env.local` for local development. Never commit real secrets.
#
# Supabase org: HealthOS · project: healthOS
# Dashboard → Project Settings → API
#
# Auth URL config (dashboard → Authentication → URL Configuration):
#   Site URL: http://localhost:3000
#   Redirect URLs: http://localhost:3000/auth/confirm
#   (production: use your real origin only — no wildcards)

# Canonical site origin used for auth email links (required in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (safe for the browser when RLS is enabled)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Service role / secret key — server only. Do NOT prefix with NEXT_PUBLIC_
# Never use this in frontend code.
# SUPABASE_SERVICE_ROLE_KEY=
